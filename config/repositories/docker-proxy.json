{
  "name": "docker-proxy",
  "online": true,
  "storage": {
    "blobStoreName": "docker-blobs",
    "strictContentTypeValidation": true
  },
  "proxy": {
    "remoteUrl": "https://registry-1.docker.io",
    "contentMaxAge": 1440,
    "metadataMaxAge": 1440
  },
  "negativeCache": {
    "enabled": true,
    "timeToLive": 1440
  },
  "httpClient": {
    "blocked": false,
    "autoBlock": true
  },
  "docker": {
    "v1Enabled": false,
    "forceBasicAuth": true
  },
  "dockerProxy": {
    "indexType": "HUB",
    "cacheForeignLayers": false
  }
}
