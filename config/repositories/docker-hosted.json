{
  "name": "docker-hosted",
  "online": true,
  "storage": {
    "blobStoreName": "docker-blobs",
    "strictContentTypeValidation": true,
    "writePolicy": "allow_once",
    "latestPolicy": true
  },
  "cleanup": {
    "policyNames": ["docker-unused-images"]
  },
  "docker": {
    "v1Enabled": false,
    "forceBasicAuth": true,
    "httpPort": 8082
  }
}
