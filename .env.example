# cp .env.example .env  and then change the passwords below.
# .env is gitignored on purpose, don't commit it (it has real passwords).

# pin versions so a redeploy doesn't randomly pull a new release
NEXUS_VERSION=3.96.4
NGINX_VERSION=1.31.7-alpine

# hostname people use for docker login/push. has to match the cert or docker will complain
NEXUS_HOST=localhost
# 0.0.0.0 = reachable from the network, 127.0.0.1 = only this machine
BIND_ADDRESS=0.0.0.0
NEXUS_UI_PORT=8443
REGISTRY_PUSH_PORT=5000
REGISTRY_PULL_PORT=5001

# memory for nexus. sonatype says keep Xms = Xmx and direct memory about the same as heap.
# on a small laptop 1g/1g/3g is enough to play around with
NEXUS_HEAP=2g
NEXUS_DIRECT_MEMORY=2g
NEXUS_MEMORY_LIMIT=6g

# bootstrap.sh sets the admin password and creates the CI user with these
NEXUS_ADMIN_PASSWORD=change-me-admin-Passw0rd
CI_USERNAME=ci-pusher
CI_PASSWORD=change-me-ci-Passw0rd

# set to true if you want people to pull without docker login
ANONYMOUS_PULL=false
# cached docker hub images that nobody pulled for this many days get purged
CLEANUP_UNUSED_DAYS=90
