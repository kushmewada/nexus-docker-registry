upstream nexus_ui       { server nexus:8081; keepalive 16; }
upstream registry_push  { server nexus:8082; keepalive 16; }
upstream registry_pull  { server nexus:8083; keepalive 16; }

# only used by the docker healthcheck, port 8080 isn't exposed
server {
    listen 8080;
    access_log off;
    location = /healthz { return 200 "ok\n"; }
}

# web UI and REST API
server {
    listen 443 ssl;
    http2 on;
    server_name ${NEXUS_HOST};

    include /etc/nginx/snippets/tls.conf;

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://nexus_ui;
    }
}

# docker push goes here (docker-hosted)
server {
    listen 5000 ssl;
    server_name ${NEXUS_HOST};

    include /etc/nginx/snippets/tls.conf;

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://registry_push;
    }
}

# docker pull goes here (docker-group = our images + docker hub cache)
server {
    listen 5001 ssl;
    server_name ${NEXUS_HOST};

    include /etc/nginx/snippets/tls.conf;

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://registry_pull;
    }
}
